<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- SDK on this machine is .NET 10; retarget to net8.0 when the .NET 8 SDK/runtime is installed. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.2.0</Version>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <RootNamespace>CuttingParameterVerifier</RootNamespace>
    <!-- Never treat past publish folders inside the repo as Razor/static sources (breaks BLAZOR106). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish-output\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <!-- Ensure constraints ship with publish output (implicit Content item only needs copy flags). -->
  <ItemGroup>
    <Content Update="Data\constraints.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Fallback when hosting keeps an old persisted Data/constraints.json (missing _B rules/graphs): merge targets from bundled copy shipped in the DLL. -->
    <EmbeddedResource Include="Data\constraints.json">
      <LogicalName>BundledConstraints.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
