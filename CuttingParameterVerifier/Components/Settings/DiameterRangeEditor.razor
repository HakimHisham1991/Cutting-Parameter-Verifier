@using CuttingParameterVerifier.Models

<div class="diameter-range-editor border rounded p-2 bg-light">
    <div class="row g-2 align-items-center mb-2">
        <div class="col-auto">
            <label class="form-label small mb-0">Min</label>
            <div class="input-group input-group-sm">
                <input type="number" step="any" min="0" class="form-control" style="width:5rem"
                       @bind="Range.MinD" @bind:event="oninput" />
                <span class="input-group-text">D</span>
            </div>
        </div>
        <div class="col-auto text-muted small">≤ @Variable ≤</div>
        <div class="col-auto">
            <label class="form-label small mb-0">Max</label>
            <div class="input-group input-group-sm">
                <input type="number" step="any" min="0" class="form-control" style="width:5rem"
                       @bind="Range.MaxD" @bind:event="oninput" />
                <span class="input-group-text">D</span>
            </div>
        </div>
    </div>
    <div class="small text-muted font-monospace">@Range.Format(Variable)</div>
</div>

@code {
    [Parameter, EditorRequired]
    public DiameterRatioRange Range { get; set; } = null!;

    [Parameter, EditorRequired]
    public string Variable { get; set; } = null!;
}
