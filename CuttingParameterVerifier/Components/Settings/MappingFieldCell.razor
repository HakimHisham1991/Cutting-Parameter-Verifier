@using CuttingParameterVerifier.Models
@using CuttingParameterVerifier.Services

<div class="cpv-mapping-field-cell">
    <div class="input-group input-group-sm">
        <input class="form-control @(Enabled ? "" : "cpv-mapping-field-off")"
               value="@(Enabled ? Value : MappingRule.IgnoredFieldPlaceholder)"
               disabled="@(!Enabled)"
               @oninput="OnInput" />
        <span class="input-group-text py-0 px-1">
            <div class="form-check form-switch mb-0 cpv-mapping-switch" title="@(Enabled ? "Field ON — used for matching" : "Field OFF — ignored for matching")">
                <input class="form-check-input" type="checkbox" role="switch"
                       checked="@Enabled"
                       @onchange="OnToggle" />
            </div>
        </span>
    </div>
</div>

@code {
    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public EventCallback<bool> EnabledChanged { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private async Task OnToggle(ChangeEventArgs e)
    {
        var on = e.Value is bool b && b;
        if (!on)
            await ValueChanged.InvokeAsync(MappingRule.IgnoredFieldPlaceholder);
        else if (MappingRuleExtensions.IsIgnoredPlaceholder(Value))
            await ValueChanged.InvokeAsync("");
        await EnabledChanged.InvokeAsync(on);
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        if (!Enabled) return;
        await ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");
    }
}
