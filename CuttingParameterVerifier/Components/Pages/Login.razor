@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation
@inject IAuthService Auth
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Login - CAM Cutting Verifier</PageTitle>

<div class="login-header">
    <img class="login-logo" src="Data/LOGO/ZENIX.png" alt="Zenix Aerospace UPECA" />
    <h1>CAM Cutting Verifier</h1>
</div>

<EditForm FormName="login" Model="Input!" OnValidSubmit="SignInAsync" method="post">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="error-message">@_error</div>
    }

    <div class="form-group">
        <label for="login-username">Username</label>
        <InputText id="login-username" class="form-control" @bind-Value="Input!.Username" placeholder="Enter your username" />
    </div>

    <div class="form-group">
        <label for="login-password">Password</label>
        <InputText id="login-password" type="password" class="form-control" @bind-Value="Input!.Password" placeholder="Enter your password" />
    </div>

    <button type="submit" class="btn btn-primary btn-block">Login</button>
</EditForm>

@code {
    [SupplyParameterFromForm(FormName = "login")]
    private LoginModel? Input { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new LoginModel();

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo(NormalizeReturnUrl(ReturnUrl), forceLoad: true);
    }

    private async Task SignInAsync()
    {
        _error = null;

        if (!Auth.ValidateCredentials(Input!.Username, Input.Password))
        {
            _error = "Invalid username or password.";
            return;
        }

        if (!await Auth.SignInAsync(Input.Username, Input.Password))
        {
            _error = "Unable to sign in. Please try again.";
            return;
        }

        Navigation.NavigateTo(NormalizeReturnUrl(ReturnUrl), forceLoad: true);
    }

    private static string NormalizeReturnUrl(string? returnUrl)
    {
        if (string.IsNullOrWhiteSpace(returnUrl))
            return "/";

        var path = returnUrl.Trim();
        if (!path.StartsWith('/'))
            path = "/" + path;

        return path.StartsWith("//", StringComparison.Ordinal) ? "/" : path;
    }

    private sealed class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Username { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = "";
    }
}
