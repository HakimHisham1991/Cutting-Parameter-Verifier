@page "/settings"
@rendermode InteractiveServer
@implements IDisposable
@using System.Text.Json
@using System.Text.Json.Serialization
@using CuttingParameterVerifier.Models
@using CuttingParameterVerifier.Services
@using CuttingParameterVerifier.Components.Settings
@inject IConstraintService Constraints
@inject CuttingSessionState Session

<PageTitle>Verifier settings</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Settings</h1>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" @onclick="ReloadAsync">Reload</button>
        <button type="button" class="btn btn-primary" @onclick="SaveAsync">Save configuration</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success")">@_message</div>
}

<div class="row g-3">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header">Mapping table</div>
            <div class="card-body">
                <p class="text-muted small mb-2">
                    Match is case-insensitive on each <strong>ON</strong> field. Toggle a field <strong>OFF</strong> to ignore it (shows N/A, greyed out). Leave <strong>Process Specs</strong> blank when ON to match any imported value.
                    If no rule matches, both evaluations are N/A. Multiple rows with the same key but different graph numbers match every listed figure.
                </p>
                <div class="table-responsive">
                    <table class="table table-sm align-middle cpv-mapping-table">
                        <thead class="table-light">
                            <tr>
                                <th>Process Specs</th>
                                <th>Material</th>
                                <th>Surface type</th>
                                <th>Milling type</th>
                                <th>Tool type</th>
                                <th>Strategy type</th>
                                <th>Graph number</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rule in _model.MappingRules)
                            {
                                <tr>
                                    <td>
                                        <MappingFieldCell @bind-Enabled="rule.UseProcessSpecs"
                                                          @bind-Value="rule.ProcessSpecs" />
                                    </td>
                                    <td>
                                        <MappingFieldCell @bind-Enabled="rule.UseMaterial"
                                                          @bind-Value="rule.Material" />
                                    </td>
                                    <td>
                                        <MappingFieldCell @bind-Enabled="rule.UseSurfaceType"
                                                          @bind-Value="rule.SurfaceType" />
                                    </td>
                                    <td>
                                        <MappingFieldCell @bind-Enabled="rule.UseMillingType"
                                                          @bind-Value="rule.MillingType" />
                                    </td>
                                    <td>
                                        <MappingFieldCell @bind-Enabled="rule.UseToolType"
                                                          @bind-Value="rule.ToolType" />
                                    </td>
                                    <td>
                                        <MappingFieldCell @bind-Enabled="rule.UseStrategyType"
                                                          @bind-Value="rule.StrategyType" />
                                    </td>
                                    <td><input class="form-control form-control-sm" @bind="rule.GraphNumber" /></td>
                                    <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveRule(rule)">Delete</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddRule">Add mapping row</button>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-xl-2">
        <div class="card shadow-sm h-100">
            <div class="card-header">Graph selector</div>
            <div class="card-body">
                <label class="form-label">Graph number</label>
                <select class="form-select" value="@_selectedGraphNumber" @onchange="OnGraphSelectionChanged">
                    @foreach (var g in _model.Graphs.OrderBy(x => x.GraphNumber, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@g.GraphNumber">@g.GraphNumber</option>
                    }
                </select>
                <hr />
                <button type="button" class="btn btn-sm btn-outline-primary w-100 mb-2" @onclick="AddGraph">Add graph</button>
                <button type="button" class="btn btn-sm btn-outline-danger w-100 mb-3" @onclick="RemoveSelectedGraph" disabled="@(_activeGraph is null)">Delete selected graph</button>
                @if (_activeGraph is not null)
                {
                    <label class="form-label">Rename graph number</label>
                    <input class="form-control form-control-sm" @bind="_activeGraph.GraphNumber" @bind:after="OnConstraintEdited" />
                    <div class="form-text">Identifiers may include dotted codes (e.g. 3.2.2.4.1.2).</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-9 col-xl-10">
        @if (_activeGraph is null)
        {
            <div class="card shadow-sm">
                <div class="card-header">Constraint polygons</div>
                <div class="card-body">
                    <p class="text-muted mb-0">No graphs defined.</p>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                <div class="col-xl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header">Cutting (Vc, Fz)</div>
                        <div class="card-body">
                            <PointsEditor @key="@($"{_activeGraph.GraphNumber}|c")"
                                          Points="_activeGraph.CuttingPolygon"
                                          OnChanged="OnConstraintEdited" />
                        </div>
                    </div>
                </div>
                <div class="col-xl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span>Engagement</span>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="eng-diameter-mode"
                                       checked="@(_activeGraph.EngagementMode == EngagementMode.DiameterScaled)"
                                       @onchange="OnEngagementModeChanged" />
                                <label class="form-check-label small" for="eng-diameter-mode">Scale with Ø</label>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (_activeGraph.EngagementMode == EngagementMode.DiameterScaled)
                            {
                                <p class="text-muted small mb-2">
                                    Add inequalities for ae and ap vs tool Ø (D). Charts update live in the preview.
                                </p>
                                <div class="mb-3">
                                    <h3 class="h6">ae vs Ø</h3>
                                    <InequalityListEditor @key="@($"{_activeGraph.GraphNumber}|e-ae")"
                                                          Inequalities="_activeGraph.AeVsDiameterInequalities"
                                                          Variable="ae"
                                                          OnChanged="OnConstraintEdited" />
                                </div>
                                <div class="mb-3">
                                    <h3 class="h6">ap vs Ø</h3>
                                    <InequalityListEditor @key="@($"{_activeGraph.GraphNumber}|e-ap")"
                                                          Inequalities="_activeGraph.ApVsDiameterInequalities"
                                                          Variable="ap"
                                                          OnChanged="OnConstraintEdited" />
                                </div>
                                <div>
                                    <label class="form-label small mb-1">Chart Ø axis max (mm)</label>
                                    <input type="number" step="any" min="0.1" class="form-control form-control-sm"
                                           @bind="_activeGraph.DiameterPlotMaxMm"
                                           @bind:after="OnConstraintEdited" />
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small mb-2">ap × ae polygon (mm) — fixed envelope independent of tool diameter.</p>
                                <PointsEditor @key="@($"{_activeGraph.GraphNumber}|e")"
                                              Points="_activeGraph.EngagementPolygon"
                                              XLabel="ap (mm)" YLabel="ae (mm)"
                                              OnChanged="OnConstraintEdited" />
                            }
                        </div>
                    </div>
                </div>
                <div class="col-xl-4">
                    <div class="card shadow-sm h-100 settings-chart-preview-card">
                        <div class="card-header">Chart preview</div>
                        <div class="card-body settings-chart-preview-body">
                            <SettingsChartPreview Config="_model"
                                                  Graph="_activeGraph"
                                                  Results="Session.Results"
                                                  RefreshToken="_previewRefreshToken" />
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private static readonly JsonSerializerOptions CloneOpts = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        WriteIndented = false,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };

    private VerificationConfig _model = new();
    private string _selectedGraphNumber = "";
    private ConstraintGraph? _activeGraph;
    private string? _message;
    private bool _isError;
    private int _previewRefreshToken;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Reload();
    }

    private void OnSessionChanged() => InvokeAsync(() =>
    {
        BumpPreviewRefresh();
        StateHasChanged();
    });

    private void OnConstraintEdited() => BumpPreviewRefresh();

    private void BumpPreviewRefresh() => _previewRefreshToken++;

    private Task ReloadAsync()
    {
        Reload();
        _message = "Reloaded from disk.";
        _isError = false;
        return Task.CompletedTask;
    }

    private void Reload()
    {
        var json = JsonSerializer.Serialize(Constraints.Load(), CloneOpts);
        _model = JsonSerializer.Deserialize<VerificationConfig>(json, CloneOpts) ?? new VerificationConfig();
        if (_model.Graphs.Count == 0)
        {
            _selectedGraphNumber = "";
            _activeGraph = null;
            return;
        }

        if (string.IsNullOrWhiteSpace(_selectedGraphNumber) ||
            _model.Graphs.All(g => !string.Equals(g.GraphNumber, _selectedGraphNumber, StringComparison.Ordinal)))
        {
            _selectedGraphNumber = _model.Graphs[0].GraphNumber;
        }

        _activeGraph = _model.Graphs.First(g => string.Equals(g.GraphNumber, _selectedGraphNumber, StringComparison.Ordinal));
        if (_activeGraph.EngagementMode == EngagementMode.DiameterScaled)
            EnsureDiameterInequalities(_activeGraph);
        BumpPreviewRefresh();
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(_selectedGraphNumber))
        {
            _activeGraph = _model.Graphs.FirstOrDefault(g =>
                string.Equals(g.GraphNumber, _selectedGraphNumber, StringComparison.Ordinal));
            if (_activeGraph?.EngagementMode == EngagementMode.DiameterScaled)
                EnsureDiameterInequalities(_activeGraph);
        }
    }

    private void OnGraphSelectionChanged(ChangeEventArgs e)
    {
        _selectedGraphNumber = e.Value?.ToString() ?? "";
        _activeGraph = _model.Graphs.FirstOrDefault(g =>
            string.Equals(g.GraphNumber, _selectedGraphNumber, StringComparison.Ordinal));
        if (_activeGraph?.EngagementMode == EngagementMode.DiameterScaled)
            EnsureDiameterInequalities(_activeGraph);
        BumpPreviewRefresh();
    }

    private void OnEngagementModeChanged(ChangeEventArgs e)
    {
        if (_activeGraph is null) return;
        var enabled = e.Value is bool b && b;
        _activeGraph.EngagementMode = enabled ? EngagementMode.DiameterScaled : EngagementMode.ApAe;
        if (enabled)
            EnsureDiameterInequalities(_activeGraph);
        BumpPreviewRefresh();
    }

    private static void EnsureDiameterInequalities(ConstraintGraph g) => DiameterInequalityService.EnsureInequalities(g);

    private void AddRule() => _model.MappingRules.Add(new MappingRule());

    private void RemoveRule(MappingRule r) => _model.MappingRules.Remove(r);

    private void AddGraph()
    {
        var n = 1;
        while (_model.Graphs.Any(g => string.Equals(g.GraphNumber, n.ToString(), StringComparison.Ordinal)))
            n++;
        var g = new ConstraintGraph
        {
            GraphNumber = n.ToString(),
            CuttingPolygon = new List<Point2D> { new(0, 0), new(0, 1), new(1, 1), new(1, 0) },
            EngagementPolygon = new List<Point2D> { new(0, 0), new(0, 1), new(1, 1), new(1, 0) },
            EngagementMode = EngagementMode.ApAe,
            AeVsDiameterInequalities = new List<DiameterInequality>
            {
                new() { Expression = "ae >= 0" },
                new() { Expression = "ae <= 1*D" }
            },
            ApVsDiameterInequalities = new List<DiameterInequality>
            {
                new() { Expression = "ap >= 0.5*D" },
                new() { Expression = "ap <= 1*D" }
            },
            DiameterPlotMaxMm = DiameterInequalityService.DefaultPlotMaxMm
        };
        DiameterInequalityService.SyncPolygonsFromInequalities(g);
        _model.Graphs.Add(g);
        _selectedGraphNumber = g.GraphNumber;
        _activeGraph = g;
        BumpPreviewRefresh();
    }

    private void RemoveSelectedGraph()
    {
        if (_activeGraph is null) return;
        _model.Graphs.Remove(_activeGraph);
        _activeGraph = null;
        if (_model.Graphs.Count == 0)
        {
            _selectedGraphNumber = "";
            return;
        }

        _selectedGraphNumber = _model.Graphs[0].GraphNumber;
        _activeGraph = _model.Graphs[0];
        BumpPreviewRefresh();
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
    }

    private async Task SaveAsync()
    {
        _message = null;
        foreach (var g in _model.Graphs)
        {
            g.CuttingPolygon = PolygonNormalizer.EnsureEvaluablePolygon(g.CuttingPolygon);
            g.EngagementPolygon = PolygonNormalizer.EnsureEvaluablePolygon(g.EngagementPolygon);
            if (g.EngagementMode == EngagementMode.DiameterScaled)
            {
                DiameterInequalityService.EnsureInequalities(g);
                DiameterInequalityService.SyncPolygonsFromInequalities(g);
            }
            else
            {
                g.EngagementAeVsDiameterPolygon = PolygonNormalizer.EnsureEvaluablePolygon(g.EngagementAeVsDiameterPolygon);
                g.EngagementApVsDiameterPolygon = PolygonNormalizer.EnsureEvaluablePolygon(g.EngagementApVsDiameterPolygon);
            }
        }

        var errors = Validate(_model);
        if (errors.Count > 0)
        {
            _isError = true;
            _message = string.Join(" ", errors);
            return;
        }

        Constraints.Save(_model);
        _isError = false;
        _message = "Saved to Data/constraints.json";
        await Task.CompletedTask;
    }

    private static List<string> Validate(VerificationConfig cfg)
    {
        var errors = new List<string>();
        var dupGraphs = cfg.Graphs.GroupBy(g => g.GraphNumber.Trim(), StringComparer.OrdinalIgnoreCase).Where(g => g.Count() > 1).Select(g => g.Key).ToList();
        if (dupGraphs.Count > 0)
            errors.Add($"Duplicate graph numbers: {string.Join(", ", dupGraphs)}.");

        foreach (var g in cfg.Graphs)
        {
            if (g.CuttingPolygon.Count < 3)
                errors.Add($"Graph {g.GraphNumber}: cutting polygon needs at least three vertices (after normalization).");
            if (g.EngagementMode == EngagementMode.DiameterScaled)
                errors.AddRange(DiameterInequalityService.Validate(g));
            else if (g.EngagementPolygon.Count < 3)
            {
                errors.Add($"Graph {g.GraphNumber}: engagement polygon needs at least three vertices (after normalization).");
            }
        }

        return errors;
    }
}
