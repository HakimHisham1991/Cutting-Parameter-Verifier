@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject IAuthService Auth
@inject AuthenticationStateProvider AuthStateProvider

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="app-brand-block">
                <a class="app-brand text-body text-decoration-none" href="">CAM Cutting Verifier</a>
                <span class="app-version text-muted">@AppVersion.Display</span>
            </div>
            <div class="top-row-meta">
                <AuthorizeView>
                    <Authorized>
                        <span class="text-muted small me-2">@context.User.Identity?.Name</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LogoutAsync">Sign out</button>
                    </Authorized>
                </AuthorizeView>
                <span class="text-muted small">Blazor Server · CAM parameter verification</span>
                <span class="text-muted small top-row-attribution">Developed by UPECA PDC</span>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private async Task LogoutAsync()
    {
        await Auth.SignOutAsync();
        if (AuthStateProvider is ServerAuthStateProvider serverAuth)
            serverAuth.NotifyChanged();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
